# =====================================================
# CONFIGURACIÓN DEL SISTEMA DE BOMBEROS
# =====================================================

# Configuración de la Base de Datos PostgreSQL
# Para desarrollo local:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=formulario
# DB_USER=tu_usuario_postgres
# DB_PASSWORD=tu_password_postgres

# Para Supabase (producción):
DB_HOST=db.tu_proyecto.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=tu_password_supabase

# Configuración del Servidor
PORT=3000
NODE_ENV=development

# =====================================================
# CONFIGURACIÓN JWT (JSON Web Tokens)
# =====================================================

# Secreto para firmar tokens JWT (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET=tu_secreto_super_seguro_para_bomberos_2024_cambiar_en_produccion

# Tiempo de expiración de tokens JWT
# Opciones: 1h, 24h, 7d, 30d
JWT_EXPIRES_IN=7d

# =====================================================
# CONFIGURACIÓN DE CORS
# =====================================================

# Origen permitido para CORS (desarrollo)
CORS_ORIGIN=http://localhost:4200

# Orígenes permitidos para producción (separar con comas)
# CORS_ORIGIN=https://tudominio.com,https://www.tudominio.com

# =====================================================
# CONFIGURACIÓN DE SEGURIDAD
# =====================================================

# Tiempo máximo de sesión inactiva (en minutos)
SESSION_TIMEOUT=30

# Número máximo de intentos de login antes del bloqueo
MAX_LOGIN_ATTEMPTS=5

# Tiempo de bloqueo después de intentos fallidos (en minutos)
LOGIN_BLOCK_DURATION=15

# =====================================================
# CONFIGURACIÓN DE LOGS
# =====================================================

# Nivel de logging (error, warn, info, debug)
LOG_LEVEL=info

# Habilitar logs de auditoría
ENABLE_AUDIT_LOGS=true

# =====================================================
# CONFIGURACIÓN DE EMAIL (FUTURO)
# =====================================================

# Servidor SMTP para envío de emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_email@gmail.com
# SMTP_PASS=tu_password_aplicacion

# =====================================================
# INSTRUCCIONES DE USO
# =====================================================

# 1. Copiar este archivo como .env
# 2. Cambiar los valores según tu configuración
# 3. NUNCA subir el archivo .env al repositorio
# 4. En producción, usar variables de entorno del servidor

# IMPORTANTE: Cambiar JWT_SECRET en producción por uno seguro y único
# Puedes generar uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# =====================================================
# CONFIGURACIÓN PARA SUPABASE
# =====================================================
# Para conectar a Supabase:
# 1. Ve a tu proyecto en Supabase Dashboard
# 2. Ve a Settings > Database
# 3. Copia la información de conexión:
#    - Host: db.tu_proyecto.supabase.co
#    - Port: 5432
#    - Database: postgres
#    - User: postgres
#    - Password: (la contraseña de tu proyecto)
# 4. Actualiza las variables DB_HOST, DB_PASSWORD en tu archivo .env
# 5. Asegúrate de que NODE_ENV=production para habilitar SSL
